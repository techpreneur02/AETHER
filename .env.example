MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=aether_it
AETHER_STORAGE=mongo
AETHER_SQLITE_PATH=aether_it.sqlite3
AETHER_SECRET_KEY=replace-before-deploy
AETHER_ACCESS_TOKEN_MINUTES=480
AETHER_CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=replace-before-deploy
# Optional Remote Operations targets. Store keys/tokens only on the server, never in the browser.
AETHER_OPS_LINUX_SSH_HOST=
AETHER_OPS_LINUX_SSH_USER=
AETHER_OPS_LINUX_SSH_PORT=22
AETHER_OPS_LINUX_SSH_KEY_PATH=/run/aether-ops-keys/linux_runner
AETHER_OPS_WINDOWS_SSH_HOST=
AETHER_OPS_WINDOWS_SSH_USER=
AETHER_OPS_WINDOWS_SSH_PORT=22
AETHER_OPS_WINDOWS_SSH_KEY_PATH=/run/aether-ops-keys/windows_runner
AETHER_OPS_CPANEL_URL=
AETHER_OPS_CPANEL_USER=
AETHER_OPS_CPANEL_TOKEN=
AETHER_OPS_SSH_KEY_DIR=./deployment/keys
AETHER_OPS_SSH_KNOWN_HOSTS_PATH=/run/aether-ops-keys/known_hosts
# Optional Security Tools page. Disabled by default; enable only for authorized environments.
AETHER_SECURITY_TOOLS_ENABLED=false
AETHER_SECURITY_TOOL_KALI_ENABLED=
AETHER_SECURITY_TOOL_SPLUNK_URL=
AETHER_SECURITY_TOOL_NESSUS_URL=
AETHER_SECURITY_TOOL_OPENVAS_URL=